{
  "name": "flow-socket-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Flow Socket desktop launcher",
  "type": "commonjs",
  "main": "main.cjs",
  "scripts": {
    "prepare-assets": "rm -rf app && mkdir -p app/server app/client && cp -R ../server/dist app/server/dist && cp ../server/package.json app/server/package.json && cp -R ../client/dist app/client/dist",
    "start": "npm run prepare-assets && electron .",
    "pack:mac": "npm run prepare-assets && electron-builder --mac zip",
    "pack:win": "npm run prepare-assets && electron-builder --win zip --x64",
    "pack:dir": "npm run prepare-assets && electron-builder --dir"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.6",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.flow-socket.desktop",
    "productName": "Flow Socket",
    "asar": true,
    "files": [
      "main.cjs",
      "app/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "zip"
      ]
    },
    "win": {
      "target": [
        "zip"
      ]
    },
    "directories": {
      "output": "dist"
    }
  }
}
